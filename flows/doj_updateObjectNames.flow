    <formulas>
        <name>relatedPropertiesValue</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record.Related_Properties__c}),
    {!$Record.Properties__r.Name} &amp; 
    IF(
        ISBLANK({!$Record.Properties__r.Document_Nr__c}),
        &apos;&apos;, 
        &apos;,&apos; &amp; {!$Record.Properties__r.Document_Nr__c}
    ),
    {!$Record.Related_Properties__c} &amp; 
    IF(
        ISBLANK({!$Record.Properties__r.Name}),
        &apos;&apos;, 
        &apos;,&apos; &amp; {!$Record.Properties__r.Name}
    ) &amp; 
    IF(
        ISBLANK({!$Record.Properties__r.Document_Nr__c}),
        &apos;&apos;, 
        &apos;,&apos; &amp; {!$Record.Properties__r.Document_Nr__c}
    )
)</expression>
    </formulas>
